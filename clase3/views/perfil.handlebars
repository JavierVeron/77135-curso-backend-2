<div class="container my-5">
    <div class="row my-5">
        <div class="col-md-4 offset-md-4">
            <a href="/">
                <img src="images/coderhouse.svg" alt="Coderhouse" class="img-fluid" />
            </a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4 offset-md-4">
            <h1 class="fw-bold">{{title}}</h1>
            <form>
                <div class="mb-3">
                    <label for="nombre" class="form-label">Nombre</label>
                    <input type="text" class="form-control" id="nombre" required value="{{user.first_name}}" />
                </div>
                <div class="mb-3">
                    <label for="apellido" class="form-label">Apellido</label>
                    <input type="text" class="form-control" id="apellido" required value="{{user.last_name}}" />
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="text" class="form-control" id="email" required value="{{user.email}}" />
                </div>
                <div class="mb-3">
                    <label for="edad" class="form-label">Edad</label>
                    <input type="number" class="form-control" id="edad" required  value="{{user.age}}"/>
                </div>
                <div class="mb-3">
                    <label for="contrasena" class="form-label">Contraseña</label>
                    <input type="password" class="form-control" id="contrasena" required value="{{user.password}}" />
                </div>
                <button type="button" class="btn btn-primary" id="btnModificar">Modificar</button>
                <a href="/principal" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
    <div class="row my-5">
        <div id="resultado" class="col-md-4 offset-md-4">
    </div>
</div>

<script src="./js/perfil.js"></script>